---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';
import Logo from '../assets/datsenglish-logo-primary.png';
import LanguagePicker from '../components/LanguagePicker.astro';
import '../styles/global.css';
import '../styles/single-post.css'

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

function localizedPath(path: string) {
  return lang === 'pt' ? `/${path}/` : `/${lang}/${path}/`;
}
---
  <header class="nav" id="nav">
    <a href="#" class="nav-logo"><Image src={Logo} alt="Datsenglish Logo" width={} height={40} /></a>
    <nav class="nav-links">
      <a href={localizedPath('about')}>{t("nav.about")}</a>
      <a href={localizedPath('services')}>{t("nav.services")}</a>
      <a href={localizedPath('reacts')}>{t("nav.coach-reacts")}</a>
      <a href={localizedPath('wins')}>{t("nav.wins")}</a>
      <a href={localizedPath('contact')}>{t("nav.contact")}</a>
      <a href={lang === 'pt' ? '/pt/blog/1' : '/en/blog/1'}>{t("nav.blog")}</a>
    </nav>
    <LanguagePicker />
    <a href="#booking" class="btn-primary nav-btn">
    Book free call
    </a>
    <button class="hamburger" id="hamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </header>
  <div class="mobile-menu" id="mobileMenu">
      <a href={localizedPath('about')}>{t("nav.about")}</a>
      <a href={localizedPath('services')}>{t("nav.services")}</a>
      <a href={localizedPath('reacts')}>{t("nav.coach-reacts")}</a>
      <a href={localizedPath('wins')}>{t("nav.wins")}</a>
      <a href={localizedPath('contact')}>{t("nav.contact")}</a>
      <a href={lang === 'pt' ? '/blog/1' : '/en/blog/1'}>{t("nav.blog")}</a>
  </div>