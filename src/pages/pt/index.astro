---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import Nav  from '../../components/Nav.astro'
import '../../styles/global.css';

const services = await getCollection('services');
const steps = await getCollection('steps');
---

<Layout>
    <Nav />
      <!-- HERO -->
  <section class="hero">
    <div class="hero-bg-text">DEPLOY</div>
    <div class="hero-content">
      <div class="hero-badge reveal">
        <span class="badge-dot"></span>Mentor de Inglês para Estudantes de Tecnologia
      </div>
      <h1 class="hero-h1 reveal reveal-delay-1">
        Pare de <em>traduzir.</em><br>Comece a <em>construir.</em>
      </h1>
      <p class="hero-sub reveal reveal-delay-2">
        A tecnologia funciona em inglês — documentação, tutoriais, entrevistas de emprego, Stack Overflow. Ajudo estudantes lusófonos a ler, escrever e falar inglês sem que a barreira do idioma trave o código deles.
      </p>
      <div class="hero-btns reveal reveal-delay-3">
        <a href="#booking" class="btn-primary btn-lg">Agende sua chamada gratuita</a>
        <a href="#reacts" class="btn-ghost btn-lg">Assista Coach Reacts ↓</a>
      </div>
      <div class="hero-stats reveal reveal-delay-4">
        <div class="stat">
          <span class="stat-num" data-target="200">0</span><span class="stat-num">+</span>
          <span class="stat-label">Estudantes de tecnologia treinados</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">4.9</span>
          <span class="stat-label">Avaliação média</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num" data-target="3">0</span>
          <span class="stat-label">Níveis de coaching</span>
        </div>
      </div>
    </div>
    <div class="hero-visual reveal reveal-delay-2">
      <div class="speech-bubble sb1">
        <span class="sb-tag">Dica Rápida</span>
        <p>Leia documentação em inglês. Pare de traduzir na sua cabeça.</p>
      </div>
      <div class="coach-card">
        <div class="coach-avatar-big">DE</div>
        <div class="coach-card-info">
          <strong>coach datsenglish</strong>
          <span>Especialista em Inglês Técnico</span>
        </div>
        <div class="live-badge"><ion-icon name="ellipse"></ion-icon> Ao vivo</div>
      </div>
      <div class="speech-bubble sb2">
        <span class="sb-tag">Vitória de Aluno</span>
        <p>"Passei na minha entrevista de dev em inglês!" <ion-icon name="flame"></ion-icon></p>
      </div>
      <div class="floating-pill pill1"><ion-icon name="checkmark-circle"></ion-icon> Documentação desbloqueada</div>
      <div class="floating-pill pill2">Pronto para entrevistas</div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    
    <span>Confiado por estudantes de tecnologia de</span>
    <strong>Angola</strong>
    <strong>Brasil</strong>
    <strong>Portugal</strong>
    <strong>Moçambique</strong>
    <strong>Cabo Verde</strong>
    <span>& mais</span>
  </div>

  <!-- ABOUT -->
  <section class="about section" id="about">
    <div class="container about-grid">
      <div class="about-visual">
        <div class="about-card">
          <div class="about-avatar">DE</div>
          <div class="about-tags">
            <span class="tag tag-orange">Especialista em inglês técnico</span>
            <span class="tag tag-teal">Ex-aluno de Engenharia/CC</span>
            <span class="tag tag-purple">Documentação & preparação para entrevistas</span>
            <span class="tag tag-orange">5 anos de experiência</span>
          </div>
          <div class="about-stat-row">
            <div class="mini-stat"><strong>1+</strong><span>Alunos</span></div>
            <div class="mini-stat"><strong>3</strong><span>Níveis</span></div>
            <div class="mini-stat"><strong>4.9★</strong><span>Avaliação</span></div>
          </div>
        </div>
        <div class="about-accent-box">
          "Todo estudante de tecnologia que já treinei tinha uma coisa em comum — entendia o código, só não conseguia ler a documentação."
        </div>
      </div>
      <div class="about-text">
        <div class="section-tag">Seu coach</div>
        <h2 class="section-title">Olá, eu sou o<br>coach da datsenglish</h2>
        <p>Eu mesmo estudei Engenharia Informática — então sei exatamente onde a barreira do inglês aparece: ao ler documentação, seguir tutoriais, sobreviver a uma entrevista técnica. Já ajudei mais de 1 estudante de tecnologia a superar isso.</p>
        <p>Publico toda semana análises de inglês técnico, traduções de termos e a minha série de assinatura <strong>Coach Reacts</strong> no Instagram e TikTok para ajudar alunos como você todos os dias — de graça.</p>
        <p>Seja para se preparar para uma entrevista de emprego dev, tentar ler documentação em inglês sem traduzir, ou realmente entender tutoriais sem legendas — eu te ajudo.</p>
        <a href="#booking" class="btn-primary" style="margin-top:1.5rem;display:inline-block;">Vamos trabalhar juntos</a>
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="services section" id="services">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">Serviços</div>
        <h2 class="section-title">Escolha seu nível de coaching</h2>
        <p class="section-sub">Nada de aulas genéricas. Cada sessão é construída em cima de material técnico real — documentação, tutoriais, vagas de emprego, perguntas de entrevista.</p>
      </div>
      <div class="services-grid">
        {services.map((s) => {
          const cardClass = {
            beginner: 'card-teal',
            intermediate: 'card-orange featured',
            advanced: 'card-purple',
          }[s.data.tier];
          const btnClass = s.data.tier === 'intermediate' ? 'btn-white-small' : 'btn-outline-small';
          return (
            <div class:list={['service-card', cardClass]}>
              {s.data.popular && <div class="featured-badge">Mais popular</div>}
              <div class="service-level">{s.data.tierLabel}</div>
              <h3 class="service-name">{s.data.title}</h3>
              <p class="service-desc">{s.data.description}</p>
              <ul class="service-list">
                {s.data.features.map((f) => <li>{f}</li>)}
              </ul>
              <div class="service-footer">
                <span class="service-price">A partir de <strong>{s.data.price.currency} {s.data.price.amount.toLocaleString('pt-AO')}</strong> / {s.data.price.unit}</span>
                <a href="#booking" class={btnClass}>{s.data.cta}</a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how section">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">Processo</div>
        <h2 class="section-title">3 passos para programar em inglês</h2>
      </div>
      <div class="steps">
        {steps.map((step, index) => (
          <>
            <div class="step">
              <div class="step-num">{step.data.id}</div>
              <div class="step-content">
                <h3>{step.data.title}</h3>
                <p>{step.data.description}</p>
              </div>
            </div>
            {index < steps.length - 1 && <div class="step-connector"></div>}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- COACH REACTS -->
  <section class="reacts section" id="reacts">
    <div class="container">
      <div class="reacts-grid">
        <div class="reacts-text">
          <div class="section-tag">Série de assinatura</div>
          <h2 class="section-title">Coach Reacts</h2>
          <p>Todo sábado eu reajo a inglês técnico real do mundo real — documentação, palestras de conferências, YouTubers dev — explicando o vocabulário, os termos e os padrões naturais que você realmente vai precisar.</p>
          <p>É a forma mais rápida de parar de traduzir conteúdo de tecnologia na sua cabeça. E é totalmente gratuito.</p>
          <div class="reacts-breakdown">
            <div class="breakdown-item">
              <ion-icon name="mic-outline" class="breakdown-icon"></ion-icon>
              <span>Explicações de termos dev</span>
            </div>
            <div class="breakdown-item">
              <ion-icon name="locate-outline" class="breakdown-icon"></ion-icon>
              <span>Passo a passo de docs e tutoriais</span>
            </div>
            <div class="breakdown-item">
              <ion-icon name="chatbubble-outline" class="breakdown-icon"></ion-icon>
              <span>Expressões para standups e entrevistas</span>
            </div>
            <div class="breakdown-item">
              <ion-icon name="flame-outline" class="breakdown-icon"></ion-icon>
              <span>"Termo da semana" — vocabulário tech</span>
            </div>
          </div>
          <div class="reacts-ctas">
            <a href="#" class="btn-primary">Siga no Instagram</a>
            <a href="#" class="btn-ghost">Assista no TikTok</a>
          </div>
        </div>
        <div class="reacts-visual">
          <div class="video-mock">
            <div class="video-top">
              <span class="video-user">@datsenglish</span>
              <span class="video-label">Coach Reacts #12</span>
            </div>
            <div class="video-screen">
              <div class="split-left">
                <div class="speaker-box">Documentação em inglês</div>
              </div>
              <div class="split-right">
                <div class="coach-box">Análise do coach</div>
              </div>
            </div>
            <div class="video-annotations">
              <div class="annotation a1">"deploy" ← o que realmente significa</div>
              <div class="annotation a2">Ler sem traduzir = velocidade</div>
            </div>
            <div class="video-stats">
              <span><ion-icon name="heart"></ion-icon> 4.2k</span>
              <span><ion-icon name="chatbubble-outline"></ion-icon> 318</span>
              <span><ion-icon name="arrow-redo-outline"></ion-icon> 901 compartilhamentos</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="testimonials section" id="testimonials">
    <div class="container">
      <div class="section-header">
        <div class="section-tag">Vitórias de alunos</div>
        <h2 class="section-title">Resultados reais, devs reais</h2>
        <p class="section-sub">Não são milagres da noite para o dia. São estudantes de tecnologia que apareceram, fizeram o trabalho e pararam de deixar o inglês travá-los.</p>
      </div>
      <div class="testi-grid">
        <div class="testi-card">
          <div class="stars">
            <ion-icon name="star"></ion-icon>
            <ion-icon name="star"></ion-icon>
            <ion-icon name="star"></ion-icon>
            <ion-icon name="star"></ion-icon>
            <ion-icon name="star"></ion-icon>
          </div>
          <p class="testi-quote">"Eu tinha pavor de falar inglês nos standups. Depois de 6 sessões, eu estava liderando code reviews em inglês. Meu tech lead ficou chocado. Eu também, honestamente!"</p>
          <div class="testi-author">
            <div class="testi-avatar" style="background:#FFFDE7;color:#7A5C00;">KO</div>
            <div>
              <strong>Kwame O.</strong>
              <span>Engenheiro de software, Gana</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LEAD MAGNET -->
  <section class="lead-magnet section">
    <div class="container">
      <div class="magnet-inner">
        <div class="magnet-badge">Recurso gratuito</div>
        <h2>Receba o desafio de<br>7 dias de inglês técnico</h2>
        <p>7 exercícios diários para te ajudar a ler documentação, seguir tutoriais e falar sobre seu código em inglês — sem precisar traduzir. Junte-se a mais de 1.000 estudantes de tecnologia que já usam, totalmente grátis.</p>
        <form class="email-form" id="emailForm">
          <input type="email" placeholder="Seu endereço de e-mail" required class="email-input" />
          <button type="submit" class="btn-primary">Enviar para mim</button>
        </form>
        <span class="magnet-note">Sem spam. Cancele quando quiser.</span>
      </div>
    </div>
  </section>

  <!-- BOOKING -->
  <section class="booking section" id="booking">
    <div class="container">
      <div class="booking-grid">
        <div class="booking-text">
          <div class="section-tag">Agende uma sessão</div>
          <h2 class="section-title">Pronto para subir de nível?</h2>
          <p>Comece com uma chamada de descoberta gratuita de 20 minutos. Sem pressão, sem compromisso — só uma conversa honesta sobre onde você está com o inglês e onde seus estudos ou sua carreira precisam que você chegue.</p>
          <div class="booking-perks">
            <div class="perk"><ion-icon name="checkmark-circle"></ion-icon> Chamada gratuita de descoberta de 20 min</div>
            <div class="perk"><ion-icon name="checkmark-circle"></ion-icon> Plano personalizado de inglês técnico incluído</div>
            <div class="perk"><ion-icon name="checkmark-circle"></ion-icon> Horários flexíveis</div>
            <div class="perk"><ion-icon name="checkmark-circle"></ion-icon> Garantia de devolução do dinheiro</div>
          </div>
        </div>
        <div class="booking-form-card" id="contact">
          <form id="bookingForm">
            <h3>Agende sua chamada gratuita</h3>
            <div class="form-group">
              <label>Seu nome</label>
              <input type="text" placeholder="ex: Sofia Cardoso" required />
            </div>
            <div class="form-group">
              <label>Endereço de e-mail</label>
              <input type="email" placeholder="seu@email.com" required />
            </div>
            <div class="form-group">
              <label>Seu nível atual de inglês</label>
              <select>
                <option value="">Selecione seu nível</option>
                <option>Iniciante — Sei muito pouco</option>
                <option>Elementar — Sei o básico</option>
                <option>Intermediário — Consigo me comunicar</option>
                <option>Intermediário avançado — Quero mais fluência</option>
                <option>Avançado — Quero aperfeiçoar e refinar</option>
              </select>
            </div>
            <div class="form-group">
              <label>Qual é o seu maior desafio com o inglês técnico?</label>
              <textarea placeholder="ex: Não consigo ler documentação sem traduzir, fico travado em entrevistas técnicas..." rows="3"></textarea>
            </div>
            <button type="submit" class="btn-primary btn-full">Agendar minha chamada gratuita →</button>
            <p class="form-note">Você vai receber um link de agenda em até 24 horas.</p>
          </form>
          <div class="form-success" id="formSuccess">
            <div class="success-icon"><ion-icon name="checkmark-circle"></ion-icon></div>
            <h3>Você está agendado!</h3>
            <p>Verifique seu e-mail — seu link de agenda está a caminho. Até breve! <ion-icon name="rocket"></ion-icon></p>
          </div>
        </div>
      </div>
    </div>
  </section>
    <Footer />
</Layout>